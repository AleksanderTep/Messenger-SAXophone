POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=local-messenger
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://messenger:local-messenger@localhost:55432/messenger
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production; never commit the generated value.
AUTH_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Optional, explicit demo seed only; choose your own password (10-128 characters).
DEMO_PASSWORD=
